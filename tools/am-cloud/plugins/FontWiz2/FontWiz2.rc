#include <winres.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_FW2_WIZARD DIALOGEX 0, 0, 390, 424
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FontWiz2 - Text Geometry"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Text",-1,12,10,60,12
 EDITTEXT IDC_FW2_TEXT,12,25,366,55,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
 LTEXT "Arial",IDC_FW2_FONT,12,89,280,14
 PUSHBUTTON "Choose Font...",IDC_FW2_PICKFONT,300,86,78,20
 CONTROL "",IDC_FW2_SAMPLE,"Static",SS_CENTER | SS_CENTERIMAGE | WS_BORDER,12,113,366,32
 LTEXT "Em height (cm)",-1,12,156,85,12
 EDITTEXT IDC_FW2_HEIGHT,101,153,57,16,ES_AUTOHSCROLL
 LTEXT "Extrusion (cm)",-1,198,156,85,12
 EDITTEXT IDC_FW2_DEPTH,293,153,85,16,ES_AUTOHSCROLL
 GROUPBOX "Geometry",-1,12,178,175,56
 CONTROL "Front cap",IDC_FW2_FRONT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,192,70,12
 CONTROL "Sides",IDC_FW2_SIDES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,103,192,65,12
 CONTROL "Back cap",IDC_FW2_BACK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,22,211,70,12
 GROUPBOX "Bevel",-1,198,178,180,80
 CONTROL "Front",IDC_FW2_BEVFRONT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,208,192,46,12
 CONTROL "Sides",IDC_FW2_BEVSIDE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,261,192,46,12
 CONTROL "Back",IDC_FW2_BEVBACK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,315,192,46,12
 CONTROL "Round",IDC_FW2_ROUND,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,208,211,65,12
 CONTROL "Inward",IDC_FW2_INWARD,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,293,211,65,12
 LTEXT "Amount (mm)",-1,208,236,78,12
 EDITTEXT IDC_FW2_BEVEL,293,232,75,16,ES_AUTOHSCROLL
 LTEXT "Subdivide edges",-1,12,244,87,12
 COMBOBOX IDC_FW2_SUBDIVIDE,101,240,86,55,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 CONTROL "Apply surface color",IDC_FW2_APPLY_COLOR,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,274,128,12
 PUSHBUTTON "Choose Color...",IDC_FW2_COLOR,149,270,88,20
 LTEXT "No surface change",IDC_FW2_COLOR_SAMPLE,247,274,131,12
 PUSHBUTTON "Save Settings...",IDC_FW2_SAVE,12,302,84,20
 PUSHBUTTON "Load Settings...",IDC_FW2_LOAD,104,302,84,20
 CONTROL "Keep window open",IDC_FW2_KEEP_OPEN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,211,306,167,12
 PUSHBUTTON "Inspect Model...",IDC_FW2_INSPECT,12,328,112,20
 LTEXT "",IDC_FW2_STATUS,12,352,366,25
 CONTROL "Create a new model",IDC_FW2_NEW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,395,150,12
 DEFPUSHBUTTON "Create Text",IDOK,211,392,80,20
 PUSHBUTTON "Cancel",IDCANCEL,299,392,79,20
END

IDD_FW2_INSPECTOR DIALOGEX 0, 0, 680, 420
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FontWiz2 - Model Inspector"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Capture before saving in A:M. Group values are captured first; Capture model code invokes the SDK serializer in memory.",-1,10,8,660,24
 LTEXT "Captured current model (select text and Ctrl+C to copy)",-1,10,36,325,12
 LTEXT "Saved file (read from disk; not loaded into A:M)",-1,345,36,325,12
 EDITTEXT IDC_FW2_CURRENT_CODE,10,52,325,320,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
 EDITTEXT IDC_FW2_SAVED_CODE,345,52,325,320,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
 PUSHBUTTON "Capture model code",IDC_FW2_CAPTURE_CODE,10,386,114,22
 PUSHBUTTON "Save snapshot...",IDC_FW2_SAVE_SNAPSHOT,132,386,105,22
 PUSHBUTTON "Open saved model...",IDC_FW2_LOAD_MODEL,345,386,118,22
 PUSHBUTTON "Close",IDCANCEL,590,386,80,22
END
