#include <windows.h>
#include "resource.h"
IDD_SETBIASER DIALOGEX 0, 0, 224, 176
STYLE DS_SETFONT | DS_CONTROL | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "Setbiaser 0.1.0-preview"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    COMBOBOX IDC_SCOPE, 7, 7, 94, 58, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "No targets", IDC_COUNT, 108, 9, 109, 12
    COMBOBOX IDC_OPERATION, 7, 27, 94, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Link In/Out", IDC_LINK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 111, 28, 102, 12
    LTEXT "In", -1, 82, 49, 28, 10
    LTEXT "Out", -1, 153, 49, 28, 10
    LTEXT "Magnitude", -1, 7, 65, 54, 11
    LTEXT "Alpha", -1, 7, 86, 54, 11
    LTEXT "Gamma", -1, 7, 107, 54, 11
    EDITTEXT IDC_VALUE0, 64, 62, 52, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<>", IDC_SCRUB0, 117, 62, 18, 15, WS_TABSTOP
    EDITTEXT IDC_VALUE1, 143, 62, 52, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<>", IDC_SCRUB1, 196, 62, 18, 15, WS_TABSTOP
    EDITTEXT IDC_VALUE2, 64, 83, 52, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<>", IDC_SCRUB2, 117, 83, 18, 15, WS_TABSTOP
    EDITTEXT IDC_VALUE3, 143, 83, 52, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<>", IDC_SCRUB3, 196, 83, 18, 15, WS_TABSTOP
    EDITTEXT IDC_VALUE4, 64, 104, 52, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<>", IDC_SCRUB4, 117, 104, 18, 15, WS_TABSTOP
    EDITTEXT IDC_VALUE5, 143, 104, 52, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<>", IDC_SCRUB5, 196, 104, 18, 15, WS_TABSTOP
    LTEXT "Magnitude: % | Angles: degrees", IDC_UNITS, 7, 123, 208, 10
    PUSHBUTTON "Options", IDC_OPTIONS, 7, 138, 45, 15, WS_TABSTOP
    PUSHBUTTON "Refresh", IDC_REFRESH, 57, 138, 45, 15, WS_TABSTOP
    LTEXT "Commit on release / Enter", -1, 109, 141, 110, 10
    LTEXT "Run Setbiaser again to bind a new selection.", IDC_STATUS, 7, 158, 208, 15
END
1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "Setbiaser modeless bias editor - host-test candidate\0"
   VALUE "FileVersion", "0.1.0-preview\0"
   VALUE "ProductName", "Setbiaser\0"
   VALUE "ProductVersion", "0.1.0-preview\0"
   VALUE "Comments", "Inspired by Emilio Le Roux's Setbias. New implementation with AI assistance.\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
