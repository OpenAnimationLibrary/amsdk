#include <winres.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_IMPORT DIALOGEX 0, 0, 365, 254
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "GLB Import - Quad Patches"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_SUMMARY, 10, 10, 345, 169, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Centimeters per GLB unit:", -1, 10, 190, 129, 12
    EDITTEXT IDC_SCALE, 143, 187, 74, 15, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Mirror Z axis", IDC_MIRROR, 232, 189, 105, 14
    LTEXT "100 follows glTF meters. Control points remain peaked to preserve the surface.", -1, 10, 209, 345, 18
    DEFPUSHBUTTON "Import", IDOK, 239, 232, 55, 14
    PUSHBUTTON "Cancel", IDCANCEL, 300, 232, 55, 14
END
