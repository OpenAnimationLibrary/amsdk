#include <winres.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_PATCH_DRAW DIALOGEX 0,0,610,395
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "A:M Patch Draw v0.1 - Canvas / Export Plan"
FONT 9,"Segoe UI"
BEGIN
    LTEXT "Draw surface coverage. Each painted cell proposes four native patches.",IDC_CAPTION,10,8,570,16
    CONTROL "",IDC_CANVAS,"STATIC",WS_CHILD | WS_VISIBLE | WS_TABSTOP | SS_NOTIFY,10,30,400,315
    CONTROL "Draw",IDC_DRAW,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,430,30,70,16
    CONTROL "Erase",IDC_ERASE,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,510,30,70,16
    LTEXT "Brush diameter (drawing cells)",IDC_BRUSH_LABEL,430,54,160,12
    COMBOBOX IDC_BRUSH,430,68,160,90,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "",IDC_BRUSH_SIZE,430,88,160,28
    LTEXT "New drawing: cells per side",IDC_GRID_LABEL,430,122,160,12
    COMBOBOX IDC_GRID,430,136,70,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Cell size (A:M model units)",IDC_CELL_LABEL,430,160,160,12
    EDITTEXT IDC_CELL_SIZE,430,174,70,16,ES_NUMBER | ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "New Drawing",IDC_NEW_DRAWING,510,136,80,18
    PUSHBUTTON "Undo",IDC_UNDO_DRAWING,430,201,48,18
    PUSHBUTTON "Redo",IDC_REDO_DRAWING,483,201,48,18
    PUSHBUTTON "Clear",IDC_CLEAR_DRAWING,536,201,54,18
    LTEXT "",IDC_SUMMARY,430,229,160,115
    LTEXT "Stage B: no A:M model changes. Export JSON, close this canvas, then load it with Script Builder. Escape cancels an unfinished stroke.",IDC_GUIDE,10,352,570,26
    LTEXT "",IDC_SESSION,10,379,390,12
    PUSHBUTTON "Export Plan...",IDC_EXPORT_PLAN,420,375,105,18
    PUSHBUTTON "Close",IDCANCEL,535,375,65,18
END
