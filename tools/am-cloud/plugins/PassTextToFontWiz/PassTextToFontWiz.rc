#include <winres.h>
#include "resource.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDD_FW2_LAUNCHER DIALOGEX 0, 0, 360, 181
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Pass text to FontWiz2"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Enter text, then open FontWiz2 to choose its font and geometry.",-1,12,10,336,20
 EDITTEXT IDC_FW2_INPUT,12,33,336,66,ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_TABSTOP
 LTEXT "Ready.",IDC_FW2_RESULT,12,108,336,30
 DEFPUSHBUTTON "Open FontWiz2...",IDC_FW2_OPEN,156,149,108,20
 PUSHBUTTON "Close",IDCANCEL,276,149,72,20
END
